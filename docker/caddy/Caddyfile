# tsengine production TLS edge (docs/production-single-box.md §5 P3, threat T7).
#
# The ONLY publicly-exposed surface. Terminates HTTPS, sets security headers, and routes:
#   /v1/*, /ui, /healthz  → the platform API/console (internal :8090)
#   everything else (/, /api/*, assets) → the Next.js console (internal :3000)
# The platform + frontend ports are NOT published — they're reachable only on the internal
# `edge` network. /metrics is deliberately NOT routed here (ops-only; scrape it internally).
#
# For a PUBLIC domain: set TSENGINE_SITE_ADDRESS=your.domain, comment out `tls internal`
# below, and (optionally) add `email you@your.domain` here for ACME contact.

{$TSENGINE_SITE_ADDRESS:localhost} {
	# TLS mode is CONFIGURED, not hand-edited. This previously required commenting out
	# `tls internal` by hand before a public deploy — easy to forget, and the failure mode
	# (a browser-untrusted self-signed cert on a public domain) looks like a broken site.
	#
	# Both forms below are valid single-argument `tls` directives:
	#   TSENGINE_TLS unset        -> `tls internal`       self-signed; right for localhost/IP
	#   TSENGINE_TLS=you@dom.com  -> `tls you@dom.com`    automatic Let's Encrypt, that contact
	#
	# deploy-single-box.sh sets this from TSENGINE_ACME_EMAIL whenever the site address is a
	# real domain, so a public deploy gets trusted HTTPS with no manual edit.
	tls {$TSENGINE_TLS:internal}

	# Security headers on every response (T7 + general hardening).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Platform API + server-rendered console + health.
	# reverse_proxy sets X-Forwarded-For (the real client IP) automatically — the platform's public
	# /v1/assess rate limiter reads it (gated by TSENGINE_TRUSTED_PROXY_CIDRS) so each visitor gets
	# their own per-IP bucket instead of all traffic sharing Caddy's container IP.
	@platform path /v1/* /ui /ui/* /healthz
	handle @platform {
		reverse_proxy platform:8090
	}

	# Everything else → the Next.js console (it proxies /api/* to the platform server-side).
	handle {
		reverse_proxy frontend:3000
	}
}
