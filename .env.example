# Copy to .env and fill in before `make deploy-prod` (or `docker compose up`).
# Grouped: REQUIRED core first, then the production surfaces (HTTPS, email, AI),
# then OPTIONAL integrations. Anything left blank degrades gracefully — the app
# still runs, that feature is just off (and says so honestly).

# ─────────────────────────────────────────────────────────────────────────────
# 1. REQUIRED — the app will not start (or won't be safe) without these
# ─────────────────────────────────────────────────────────────────────────────

# AES-256 key (base64, 32 bytes) that seals OAuth tokens + tenant secrets at rest. REQUIRED.
# Generate:  openssl rand -base64 32
TSENGINE_SECRET_KEY=

# Operator/API bearer token. Users sign in with email/password; this is for the operator
# API (POST /v1/tenants), Slack callbacks, and the cross-tenant practitioner desk. The prod
# compose REFUSES to start if unset. Generate:  openssl rand -hex 32
TSENGINE_PLATFORM_TOKEN=

# Database — one switch: SQLite now, Postgres to deploy.
#   unset            → durable local SQLite (binary: ./platform.db; prod compose: /data on a volume)
#   postgres:// DSN  → managed Postgres (Supabase / RDS / Neon); schema auto-creates, backend
#                      goes stateless (run N boxes behind an LB). Recommended for production:
#   TSENGINE_PLATFORM_DB=postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres?sslmode=require
#   memory           → ephemeral (throwaway runs only)
TSENGINE_PLATFORM_DB=

# ─────────────────────────────────────────────────────────────────────────────
# 2. HTTPS / public domain — needed for a real internet-facing deploy
#    (consumed by docker/caddy/Caddyfile via docker-compose.prod.yml)
# ─────────────────────────────────────────────────────────────────────────────

# The domain Caddy serves + gets a Let's Encrypt cert for. Also DROP `tls internal`
# in docker/caddy/Caddyfile so Caddy uses public ACME instead of its localhost CA.
TSENGINE_SITE_ADDRESS=app.yourdomain.com
TSENGINE_ACME_EMAIL=you@yourdomain.com

# Public base URL of the platform — used to build OAuth redirect URIs + email links.
# Behind the Caddy TLS edge this is your https domain.
TSENGINE_PLATFORM_PUBLIC=https://app.yourdomain.com

# ─────────────────────────────────────────────────────────────────────────────
# 3. Email (SMTP) — REQUIRED for password reset + member invites to actually send.
#    Unset → reset links are logged to stderr instead of emailed (dev fallback).
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=TensorShield <no-reply@yourdomain.com>

# ─────────────────────────────────────────────────────────────────────────────
# 4. The AI brain (L2 agents + plain-English brief). Unset → AI features are OFF
#    (operator-global fallback; tenants can still bring their own key in Settings).
#    LLM_PROVIDER: openai | anthropic | ollama (or compatible). For a local Ollama,
#    set LLM_BASE_URL=http://host.docker.internal:11434/v1 and LLM_API_KEY=ollama.
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# 5. OPTIONAL — connectors. Set what each system needs; unset connectors simply
#    don't appear as options.
#
#    Most are OAuth apps and take a CLIENT_ID/CLIENT_SECRET pair. THE THREE CLOUD
#    CONNECTORS DO NOT — they onboard by role-assumption, so they take different
#    settings entirely and are listed separately below. Leaving them out here was
#    a real gap: /v1/connect/aws refused with "set its CLIENT_ID and CLIENT_SECRET",
#    which AWS has never had, and pointed at this file, which did not name what it
#    actually needs.
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
AZURE_DEVOPS_CLIENT_ID=
AZURE_DEVOPS_CLIENT_SECRET=
AZURE_DEVOPS_ORG=
# Cloud accounts — role-assumption onboarding, NOT OAuth (no client secret exists).
# AWS: the customer launches this CloudFormation stack, which creates a read-only role
# trusting your platform account. Both are required before /v1/connect/aws will start.
AWS_CFN_TEMPLATE_URL=
AWS_TRUST_ACCOUNT_ID=
AWS_REGION=
# GCP: the service account customers grant viewer access to (impersonation target).
GCP_TRUST_SERVICE_ACCOUNT=
# Azure: the app registration customers consent to in their tenant.
AZURE_TRUST_APP_ID=

# Identity / non-tech (Workspace posture):
GWORKSPACE_CLIENT_ID=
GWORKSPACE_CLIENT_SECRET=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_ORG_URL=
# Ticketing (operator-default Jira; tenants can also set their own in Settings):
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=

# ─────────────────────────────────────────────────────────────────────────────
# 6. OPTIONAL — notifications (operator-global fallback; tenants route to their own
#    Slack webhook from Settings). Slack signing secret verifies approval buttons.
# ─────────────────────────────────────────────────────────────────────────────
TSENGINE_SLACK_WEBHOOK=
TSENGINE_SLACK_SIGNING_SECRET=
TSENGINE_TEAMS_WEBHOOK=
TSENGINE_DISCORD_WEBHOOK=
TSENGINE_WEBHOOK_URL=
TSENGINE_WEBHOOK_SIGNING_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# 7. Tuning / ops (sane defaults shown)
# ─────────────────────────────────────────────────────────────────────────────

# Continuous-monitoring re-scan cadence (e.g. 6h; 0 disables). Default 12h.
TSENGINE_MONITOR_INTERVAL=12h

# Verifies inbound webhooks (recommended in production; empty = unverified).
TSENGINE_WEBHOOK_SECRET=

# Observability. Logs to stderr; json in production for a log pipeline.
# Prometheus scrapes GET /metrics (network-restrict it — it is NOT auth-gated).
TSENGINE_LOG_FORMAT=json
TSENGINE_LOG_LEVEL=info

# Background-scan worker pool (Scan now / webhook re-scans run off the request path).
TSENGINE_SCAN_WORKERS=2
TSENGINE_SCAN_TIMEOUT=30m

# ─────────────────────────────────────────────────────────────────────────────
# 8. Public site identity & legal (BUILD-TIME — Next.js inlines NEXT_PUBLIC_* into
#    the bundle, so changing these requires a frontend REBUILD, not a restart)
# ─────────────────────────────────────────────────────────────────────────────

# Canonical public URL for canonical tags, sitemap, and robots.
# Defaults to https://$TSENGINE_SITE_ADDRESS when unset.
NEXT_PUBLIC_SITE_URL=

# HOW CUSTOMERS REACH YOU. Set once here; frontend/lib/contact.ts is the only place these
# are read, and it feeds the footer (every marketing page), the /contact page, the legal
# documents and .well-known/security.txt.
#
# Both default to the live values in frontend/lib/contact.ts and only need setting here to
# OVERRIDE them for a particular deploy. Leaving them empty publishes the defaults; the
# surfaces render a channel only when it is non-empty, so blanking the constant itself
# drops it cleanly rather than leaving a label with nothing beside it.
#   e.g. NEXT_PUBLIC_CONTACT_EMAIL="hello@yourdomain.com"
#        NEXT_PUBLIC_CONTACT_PHONE="+91 80 4718 2100"
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Only if the dialable form differs from the displayed one (an extension, say). Otherwise
# it is derived from NEXT_PUBLIC_CONTACT_PHONE by stripping non-dialable characters.
NEXT_PUBLIC_CONTACT_PHONE_TEL=

# Role addresses. These default to NEXT_PUBLIC_CONTACT_EMAIL — the one mailbox that is
# actually monitored — so privacy requests, vulnerability reports and contract questions all
# arrive somewhere. Set them individually once real role mailboxes exist; /contact then shows
# them as separate cards on its own, and .well-known/security.txt picks up the security one.
#
# Do NOT point these at an address that has not been verified to receive mail. privacy@ is
# where GDPR and DPDP data-subject requests are legally directed and security@ is what a
# researcher uses to report a vulnerability — both fail silently when they bounce.
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_SECURITY_EMAIL=
NEXT_PUBLIC_LEGAL_EMAIL=

# REQUIRED BEFORE ACCEPTING REAL CUSTOMERS. The Terms and Privacy pages are binding
# agreements: they must name the contracting entity and the forum whose courts have
# jurisdiction. Leave these empty and the documents render without them (honest, but
# not yet enforceable) — `make prod-validate` warns.
#   e.g. NEXT_PUBLIC_LEGAL_ENTITY="Acme Technologies Pvt Ltd"
#        NEXT_PUBLIC_LEGAL_JURISDICTION_CITY="Bengaluru"
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_JURISDICTION_CITY=
NEXT_PUBLIC_LEGAL_COUNTRY=India
NEXT_PUBLIC_LEGAL_ADDRESS=

# GDPR Art. 28(2) requires each subprocessor to be NAMED. Set this to the email
# provider actually in use (e.g. "Amazon SES", "Postmark", "SendGrid") so the
# /subprocessors page discloses it instead of saying "not yet disclosed".
NEXT_PUBLIC_SMTP_SUBPROCESSOR=

# Threat-intel corpus (KEV/EPSS/ExploitDB) — refreshed in-process onto the durable
# volume. Unset = the small embedded snapshot is used forever, silently.
TSENGINE_THREAT_INTEL_CORPUS=/data/threat_intel.json
TSENGINE_CORPUS_REFRESH_INTERVAL=24h
# ADR 0019 — OFFENSIVE-face exploit-intel sidecar for the L2 pentester's bounded exploitation-checker.
# Opt-in (the source archive is large); only meaningful with TSENGINE_THREAT_INTEL_CORPUS set. Set
# TSENGINE_EXPLOIT_INTEL=1 to build it from the nuclei-templates main-branch archive on each corpus
# refresh, or pin a tag/commit tarball with TSENGINE_EXPLOIT_INTEL_URL for a reproducible evidence pack.
TSENGINE_EXPLOIT_INTEL=
TSENGINE_EXPLOIT_INTEL_URL=

# CISA Vulnrichment (SSVC) — the 7th free threat-intel feed, and the only one carrying CISA's own
# DECISION assessment. Its Automatable point answers what none of the other six can: whether an
# attacker can automate the kill chain, which is the difference between one target exploited by hand
# and an estate. It also lets a CVE CISA says is ACTIVELY EXPLOITED qualify for a targeted probe even
# when KEV has not catalogued it — KEV covers ~1,700 CVEs and CISA assesses far more.
#
# Opt-in because the archive is ~300k files, and best-effort: a failed fetch leaves the other six
# untouched. Set TSENGINE_SSVC=1 to fetch the develop-branch archive on each corpus refresh, or pin a
# tarball with TSENGINE_SSVC_URL for a reproducible evidence pack.
TSENGINE_SSVC=
TSENGINE_SSVC_URL=

# NVD CVSS base scores + vectors. NOTHING ELSE POPULATES THE CORPUS'S CVSS FIELD — leave this empty and
# every refreshed entry scores 0, which is a real CVSS value meaning "no impact". URL-only on purpose:
# NVD publishes no single canonical archive to default to (the live API is paginated and rate-limited),
# so point this at a bulk mirror. Best-effort, like the other opt-in feeds.
TSENGINE_NVD_URL=

# CWE attribution (§8 triage tier). The compliance crosswalk keys on CWE, so a scanner finding that
# arrives without one gets NO control mapping at all — and grype and osv-scanner never set one. When a
# tenant has a model configured, a bounded number of unclassified findings per scan are classified into
# the crosswalk's OWN key set (a class we cannot map is discarded, never annotated). Set to 0 to
# disable; empty uses the default of 25. Costs nothing without a tenant model.
TSENGINE_CWE_ATTRIBUTION_MAX=

# Pin the sandbox image that executes the security tooling. Never use `latest` in
# production — a scan records sandbox_image_digest as evidence (CLAUDE.md §6), which
# is only meaningful against a fixed image.
TSENGINE_SANDBOX_IMAGE=tsengine/sandbox:0.1.0

# Detection Skills library (ADR 0017) — a folder of <name>/SKILL.md files carrying the
# investigation reasoning attached to an alert. Unset uses the bundled ./skills when present.
# Skills are UNTRUSTED input: one claiming capability (tools/scope/budget/approval) is refused
# at load and logged. Requires an LLM to be configured; without one, triage annotation is off.
TSENGINE_SKILLS_DIR=

# ─────────────────────────────────────────────────────────────────────────────
# 6. OPERATOR SWITCHES — read by the platform, previously undocumented
#
#    These were all read by cmd/platform but named nowhere in this file, so an
#    operator could not discover them. Several decide whether the product may
#    WRITE to a customer's systems or run live exploitation, which is not a
#    thing to leave undiscoverable. A test now fails if a new one is added
#    without a line here (cmd/platform/envdoc_test.go).
# ─────────────────────────────────────────────────────────────────────────────

# Listen address (default :8090). $PORT is honoured when this is unset.
TSENGINE_PLATFORM_ADDR=

# --- Live cloud remediation. OFF unless set. -------------------------------
# These let an APPROVED fix actually write to the customer's cloud (still HITL-
# gated — §18.2 inv. 3 — never an auto-apply). Unset → the connector stays an
# honest stub that reports it cannot apply, rather than pretending it did.
# AWS: the cross-account role the platform assumes to write.
AWS_REMEDIATION_ROLE_ARN=
AWS_REMEDIATION_EXTERNAL_ID=
AWS_REMEDIATION_ENABLED=
# GCP: the service account impersonated to write.
GCP_REMEDIATION_IMPERSONATE_SA=
GCP_REMEDIATION_ENABLED=
# Azure: writes via the platform's own credential, scoped to the connection.
AZURE_REMEDIATION_ENABLED=

# --- Offensive testing ------------------------------------------------------
# 1 → wire the live active-exploitation prober. Engagements still require
# explicit consent + a named authorizer + AllowActive in the RoE; this is the
# deployment-level switch on top of that. Unset → active engagements fall back
# to the passive driver rather than claiming an exploit they never ran.
TSENGINE_ACTIVE_EXPLOIT=
# Separate, leaner image for exploitation. Unset → reuses the scan image.
TSENGINE_PENTEST_SANDBOX_IMAGE=

# --- Storage / engine -------------------------------------------------------
# Directory for per-tenant cloud inventory snapshots (durable on one box).
# Unset → in-process, lost on restart.
TSENGINE_CLOUDSNAP_DIR=
# Host directory where the platform clones repos for scanning, so the path is
# shareable into the per-scan sandbox mount. Unset → a default temp dir; an
# unusable path warns and falls back to the default.
TSENGINE_REPO_SCRATCH=
# 1 → run without the scanning engine (identity/posture surfaces still work).
TSENGINE_PLATFORM_NO_ENGINE=

# --- DEV ONLY ---------------------------------------------------------------
# 1 → allow OAuth tokens to be stored UNSEALED when TSENGINE_SECRET_KEY is
# unset. Never set this in production: it defeats §18.2 inv. 6 and the platform
# logs a warning for as long as it is on.
TSENGINE_ALLOW_UNSEALED_SECRETS=

# --- Ticketing / paging (the operator-global fallback; tenants can set their
#     own Jira under Settings). Unset → that channel is simply not used. ------
SERVICENOW_INSTANCE_URL=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
LINEAR_API_KEY=
LINEAR_TEAM_ID=
PAGERDUTY_ROUTING_KEY=

